{
  "name": "trazo-monorepo",
  "private": true,
  "type": "module",
  "description": "Generate Mermaid architecture diagrams from your infrastructure code, and catch architecture drift in pull requests.",
  "license": "MIT",
  "author": "Edgar González",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edgaragg/trazo.git"
  },
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/action"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "trazo": "node packages/cli/dist/bin.js",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "jsdom": "^28.1.0",
    "mermaid": "^12.0.0",
    "simple-git-hooks": "^2.14.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/pre-commit.mjs"
  }
}
