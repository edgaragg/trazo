{
  "name": "@edgaragg/trazo-cli",
  "version": "0.2.0",
  "description": "Generate Mermaid architecture diagrams from your infrastructure code, and catch architecture drift.",
  "license": "MIT",
  "author": "Edgar González",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edgaragg/trazo.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "trazo": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@edgaragg/trazo-core": "^0.2.0"
  },
  "homepage": "https://github.com/edgaragg/trazo#readme",
  "bugs": {
    "url": "https://github.com/edgaragg/trazo/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "architecture",
    "diagram",
    "mermaid",
    "docker-compose",
    "kubernetes",
    "cli",
    "docs-as-code",
    "bitbucket",
    "bitbucket-pipelines",
    "pull-request"
  ]
}
