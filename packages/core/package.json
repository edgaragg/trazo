{
  "name": "@edgaragg/trazo-core",
  "version": "0.2.0",
  "description": "[Alpha] Architecture model extraction, diffing and Mermaid rendering for Trazo.",
  "license": "MIT",
  "author": "Edgar González",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edgaragg/trazo.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepack": "npm run build"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "homepage": "https://github.com/edgaragg/trazo#readme",
  "bugs": {
    "url": "https://github.com/edgaragg/trazo/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "architecture",
    "diagram",
    "mermaid",
    "docker-compose",
    "kubernetes",
    "documentation",
    "docs-as-code"
  ]
}
